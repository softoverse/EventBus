<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net9.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>

        <RootNamespace>Softoverse.EventBus.InMemory</RootNamespace>

        <!-- NuGet package metadata -->
        <PackageId>Softoverse.EventBus.InMemory</PackageId>
        <Version>1.0.0</Version>
        <Title>EventBus</Title>
        <Description>EventBus</Description>
        <PackageTags>eventbus;pub-sub;mahmudabir;</PackageTags>
        <Authors>mahmudabir</Authors>
        <RepositoryUrl>https://github.com/mahmudabir/EventBus</RepositoryUrl>
        <PackageProjectUrl>https://github.com/mahmudabir/EventBus</PackageProjectUrl>
        <RepositoryType>git</RepositoryType>
        <PackageReadmeFile></PackageReadmeFile>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
        <IncludeSymbols>true</IncludeSymbols>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>
        <IncludeSource>true</IncludeSource>
        <EmbedUntrackedSources>true</EmbedUntrackedSources>
        <PublishRepositoryUrl>true</PublishRepositoryUrl>
        <Deterministic>true</Deterministic>
        <AllowedOutputExtensionsInPackageBuildOutputFolder>$(AllowedOutputExtensionsInPackageBuildOutputFolder);.pdb</AllowedOutputExtensionsInPackageBuildOutputFolder>
        <PackageOutputPath>../../packages/</PackageOutputPath>
    </PropertyGroup>

    <PropertyGroup>
        <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    </PropertyGroup>

    <PropertyGroup>
        <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
    </PropertyGroup>

    <PropertyGroup>
        <EventBusTypeConfigPath>EventBusSettings:EventBusType</EventBusTypeConfigPath>
    </PropertyGroup>

    <PropertyGroup>
        <SemiColon>%3B</SemiColon>
        <String>public const string</String>
        <BuildConstants>
            <![CDATA[
namespace $(RootNamespace)$(SemiColon)

internal static class BuildConstants
{
	$(String) EventBusTypeConfigPath = "$(EventBusTypeConfigPath)"$(SemiColon)

	$(String) Channel = "Channel"$(SemiColon)
	$(String) General = "General"$(SemiColon)
}
			]]>
        </BuildConstants>
    </PropertyGroup>

    <Target Name="GenerateBuildConstants" BeforeTargets="BeforeCompile">
        <ItemGroup>
            <GeneratedFiles Include="$(IntermediateOutputPath)BuildConstants.g.cs" />
        </ItemGroup>
        <WriteLinesToFile File="$(IntermediateOutputPath)BuildConstants.g.cs" Lines="$(BuildConstants)" Overwrite="true" />
        <ItemGroup>
            <Compile Include="$(IntermediateOutputPath)BuildConstants.g.cs" />
        </ItemGroup>
    </Target>

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="9.0.8" />
        <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="9.0.8" />
        <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="9.0.8" />
    </ItemGroup>

</Project>
